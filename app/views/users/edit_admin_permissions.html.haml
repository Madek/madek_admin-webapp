.page-header
  %h1
    Admin permissions for
    %em= @user.user_handle
  %small
    = link_to '&larr; Back to user'.html_safe, user_path(@user)

= form_tag update_admin_permissions_user_path(@user), method: :patch, class: 'form-horizontal' do

  :ruby
    admin_webapp_groups = [
      {
        title: 'Taxonomy',
        keys: %w[people roles keywords]
      },
      {
        title: 'Content',
        keys: %w[entries sets groups users vocabularies contexts delegations meta_data]
      },
      {
        title: 'System',
        keys: %w[settings api_clients io usage_terms notifications sql_assistant manage_admin_permissions]
      }
    ]
    known_keys = admin_webapp_groups.flat_map { |g| g[:keys] }
    other_keys = AdminPermission::ADMIN_WEBAPP_KEYS - known_keys
    admin_webapp_groups += [{ title: 'Other', keys: other_keys }] if other_keys.any?

  .row
    .col-sm-6
      - admin_webapp_groups.each_with_index do |group, i|
        .admin-permission-group{           style: ('margin-top: 36px' if i > 0) }
          %h4= "Admin - #{group[:title]}"
          - group[:keys].each do |key|
            - label = AdminPermission::LABELS[key]
            .checkbox
              %label
                = check_box_tag 'permission_keys[]', key, @user.has_admin_permission?(key)
                = label

    .col-sm-6
      %h4 Webapp
      - AdminPermission::WEBAPP_KEYS.each do |key|
        - label = AdminPermission::LABELS[key]
        .checkbox
          - if key == 'uberadmin_view' && @user.has_admin_permission?('uberadmin_edit')
            %label{ title: "Included via 'Uberadmin (Edit)'" }
              = check_box_tag 'permission_keys[]', key, true, disabled: true
              = label
              %small.text-muted (included via Uberadmin Edit)
          - else
            %label
              = check_box_tag 'permission_keys[]', key, @user.has_admin_permission?(key)
              = label

  %hr

  = button_tag type: 'submit', class: 'btn btn-success' do
    %span.glyphicon.glyphicon-ok
    Save
  = link_to 'Cancel', user_path(@user), class: 'btn btn-link'
