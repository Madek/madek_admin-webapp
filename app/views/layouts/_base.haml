%head
  %title= 'Madek Admin'
  = stylesheet_link_tag 'application'
  = javascript_include_tag 'application'
  = csrf_meta_tag

%body

  .navbar.navbar-default.navbar-static-top
    .container-fluid
      .navbar-header
        .navbar-brand
          Madek Admin
      %ul.nav.navbar-nav.navbar-right

        - if current_user.try(:any_admin_permission?)

          = navbar_item 'Dashboard', root_path
          - if current_user.has_admin_permission?('settings')
            = navbar_item 'Settings', app_settings_path
            - if @beta_tester_notifications
              = navbar_item 'SMTP', smtp_settings_path
          - if @beta_tester_notifications and current_user.has_admin_permission?('notifications')
            = navbar_item 'Notifications', notification_cases_path

          - if current_user.has_admin_permission?('entries') or current_user.has_admin_permission?('sets')
            %li.dropdown
              %a.dropdown-toggle{href: '#', data: { toggle: 'dropdown' }}
                Media
                %b.caret
              %ul.dropdown-menu
                - if current_user.has_admin_permission?('entries')
                  = navbar_item 'Media Entries', media_entries_path
                  = navbar_item 'Media Files', media_files_path
                - if current_user.has_admin_permission?('sets')
                  = navbar_item 'Sets', collections_path

          - if %w(users groups delegations api_clients people).any? { |key| current_user.has_admin_permission?(key) }
            %li.dropdown
              %a.dropdown-toggle{href: '#', data: { toggle: 'dropdown' }}
                Entities
                %b.caret
              %ul.dropdown-menu
                - if current_user.has_admin_permission?('users')
                  = navbar_item 'Users', users_path
                - if current_user.has_admin_permission?('groups')
                  = navbar_item 'Groups', groups_path
                - if current_user.has_admin_permission?('delegations')
                  = navbar_item 'Delegations', delegations_path
                - if current_user.has_admin_permission?('api_clients')
                  = navbar_item 'API Clients', api_clients_path
                - if current_user.has_admin_permission?('people')
                  %li.divider{role: :separator}
                  = navbar_item 'People (public)', people_path

          - if %w(vocabularies contexts meta_data keywords usage_terms roles io).any? { |key| current_user.has_admin_permission?(key) }
            %li.dropdown
              %a.dropdown-toggle{href: '#', data: { toggle: 'dropdown' }}
                Meta
                %b.caret
              %ul.dropdown-menu
                - if current_user.has_admin_permission?('vocabularies')
                  = navbar_item 'Vocabularies', vocabularies_path
                - if current_user.has_admin_permission?('contexts')
                  = navbar_item 'Contexts', contexts_path
                - if current_user.has_admin_permission?('meta_data')
                  = navbar_item 'Meta Keys', meta_keys_path
                - if current_user.has_admin_permission?('keywords')
                  = navbar_item 'Keywords', keywords_path
                - if current_user.has_admin_permission?('meta_data')
                  = navbar_item 'Meta Data', meta_datums_path
                - if current_user.has_admin_permission?('usage_terms')
                  = navbar_item 'Usage Terms', usage_terms_path
                - if current_user.has_admin_permission?('roles')
                  = navbar_item 'Roles', roles_path
                  = navbar_item 'Roles Lists', roles_lists_path
                - if current_user.has_admin_permission?('io')
                  %li.divider{role: :separator}
                  = navbar_item 'IO Interfaces', io_interfaces_path
                  = navbar_item 'IO Mappings', io_mappings_path

        - if current_user
          %li.dropdown{id: 'current-user', data: { id: current_user.try(:id) }}
            %a.dropdown-toggle{href: '#', data: { toggle: 'dropdown' }}
              %i.glyphicon.glyphicon-user
              %span= current_user.try(:to_s).presence || current_user.try(:login) || 'User'
              %b.caret
            %ul.dropdown-menu
              %li
                = link_to '/my' do
                  %i.glyphicon.glyphicon-file
                  Home/My
              %li
                :ruby
                  path = Rails.env.production? ? '/auth/sign-out' : test_sign_out_path
                = form_tag path, method: :post, name: "sign-out" do
                  = hidden_field_tag "csrf-token", auth_anti_csrf_token
                  %button.btn.btn-link
                    %i.glyphicon.glyphicon-log-out
                    Logout

  #messages.container
    = alerts do |message_type, message, alert_type|
      .alert.alert-dismissible{ class: "alert-#{alert_type}" }
        = button_tag '&times;'.html_safe, class: 'close', data: { dismiss: 'alert' }
        %strong #{message_type.capitalize}!
        = message.html_safe

  = yield :main_content
